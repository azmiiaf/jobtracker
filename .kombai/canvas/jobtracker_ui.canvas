      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Atkinson+Hyperlegible+Next:wght@200..800&family=Fragment+Mono&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css');\n.h{font-family:'Familjen Grotesk',ui-sans-serif,sans-serif}\n.b{font-family:'Atkinson Hyperlegible Next','Atkinson Hyperlegible',ui-sans-serif,sans-serif}\n.m{font-family:'Fragment Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}\n.fld{height:44px;border-radius:4px;border:1px solid var(--hair);background:var(--raised);color:var(--ink);padding:0 12px;width:100%;font-size:15px;outline:none}\n.fld:focus{outline:2px solid var(--focus);outline-offset:2px;border-color:var(--div)}\n.fld::placeholder{color:#96a29c}\n</style>\n<div class=\"b\" data-kid=\"1\" style=\"--canvas:#EEF2F0;--surface:#FBFCFA;--raised:#FFFFFF;--ink:#17201C;--ink2:#53605A;--hair:#C9D3CE;--div:#8D9C95;--pri:#087554;--pri-h:#065E44;--focus:#D49A18;--dest:#B83A45;background:var(--canvas);color:var(--ink2)\">\n    <div class=\"grid grid-cols-12 min-h-[860px]\" data-kid=\"1-1\">\n        <!-- LEFT DARK PANEL -->\n        <div class=\"col-span-5 p-10 flex flex-col justify-between\" data-kid=\"1-1-1\" style=\"background:#111915;color:#A8B7AF\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\">\n                <span class=\"inline-block w-[18px] h-[18px]\" data-kid=\"1-1-1-1-1\" style=\"border-left:2px solid #35A77D;border-bottom:2px solid #35A77D\">\n                </span>\n                <span class=\"h text-[19px] font-[650] tracking-[-0.2px]\" data-kid=\"1-1-1-1-2\" style=\"color:#EDF3EF\">\n                    Jejak\n                </span>\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <p class=\"m text-[11px] uppercase tracking-[0.14em] mb-4\" data-kid=\"1-1-1-2-1\" style=\"color:#6E7F76\">\n                    Cuplikan ledger\n                </p>\n                <div class=\"border\" data-kid=\"1-1-1-2-2\" style=\"border-color:#324039;background:#151E19;border-radius:8px\">\n                    <div class=\"px-4 py-3 border-b flex items-center justify-between\" data-kid=\"1-1-1-2-2-1\" style=\"border-color:#324039\">\n                        <span class=\"h text-[13px] font-[600]\" data-kid=\"1-1-1-2-2-1-1\" style=\"color:#EDF3EF\">\n                            PT ABC · Frontend Developer\n                        </span>\n                        <span class=\"inline-flex items-center gap-1.5 text-[11px] px-2 py-[3px] rounded-[3px] border\" data-kid=\"1-1-1-2-2-1-2\" style=\"border-color:#B8780D66;background:#B8780D1f;color:#E1AE3D\">\n                            <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-1-1-2-2-1-2-1\" style=\"background:currentColor\">\n                            </span>\n                            Wawancara\n                        </span>\n                    </div>\n                    <ol class=\"relative pl-5 p-4 ml-1\" data-kid=\"1-1-1-2-2-2\">\n                        <span class=\"absolute left-[9px] top-[22px] bottom-[26px] w-[2px]\" data-kid=\"1-1-1-2-2-2-1\" style=\"background:#324039\">\n                        </span>\n                        <li class=\"relative pb-3.5\" data-kid=\"1-1-1-2-2-2-2\">\n                            <span class=\"absolute -left-[15px] top-[6px] w-[10px] h-[10px] rounded-full\" data-kid=\"1-1-1-2-2-2-2-1\" style=\"background:#2867A5\">\n                            </span>\n                            <p class=\"m text-[11px]\" data-kid=\"1-1-1-2-2-2-2-2\">\n                                14 Sep 2026\n                            </p>\n                            <p class=\"text-[13px]\" data-kid=\"1-1-1-2-2-2-2-3\" style=\"color:#EDF3EF\">\n                                Dikirim\n                            </p>\n                        </li>\n                        <li class=\"relative pb-3.5\" data-kid=\"1-1-1-2-2-2-3\">\n                            <span class=\"absolute -left-[15px] top-[6px] w-[10px] h-[10px] rounded-full\" data-kid=\"1-1-1-2-2-2-3-1\" style=\"background:#7256A0\">\n                            </span>\n                            <p class=\"m text-[11px]\" data-kid=\"1-1-1-2-2-2-3-2\">\n                                16 Sep 2026\n                            </p>\n                            <p class=\"text-[13px]\" data-kid=\"1-1-1-2-2-2-3-3\" style=\"color:#EDF3EF\">\n                                Seleksi awal\n                            </p>\n                        </li>\n                        <li class=\"relative\" data-kid=\"1-1-1-2-2-2-4\">\n                            <span class=\"absolute -left-[18px] top-[3px] w-[16px] h-[16px] rounded-full border-[4px]\" data-kid=\"1-1-1-2-2-2-4-1\" style=\"background:#B8780D;border-color:#B8780D33\">\n                            </span>\n                            <p class=\"m text-[11px]\" data-kid=\"1-1-1-2-2-2-4-2\">\n                                18 Sep 2026\n                            </p>\n                            <p class=\"text-[13px] flex items-center gap-2\" data-kid=\"1-1-1-2-2-2-4-3\" style=\"color:#EDF3EF\">\n                                Wawancara\n                                <span class=\"m text-[10px] px-1.5 py-[1px] rounded-[3px] border\" data-kid=\"1-1-1-2-2-2-4-3-1\" style=\"border-color:#324039;color:#8D9C95\">\n                                    Saat ini\n                                </span>\n                            </p>\n                        </li>\n                    </ol>\n                </div>\n                <p class=\"text-[14px] mt-8 max-w-[330px] leading-[1.6]\" data-kid=\"1-1-1-2-3\">\n                    CV disimpan sebagai nama versi, bukan file. Tidak ada unggahan dokumen.\n                </p>\n            </div>\n            <p class=\"m text-[11px]\" data-kid=\"1-1-1-3\" style=\"color:#6E7F76\">\n                Job Application Tracker · 2026\n            </p>\n        </div>\n        <!-- RIGHT FORM -->\n        <div class=\"col-span-7 flex items-center\" data-kid=\"1-1-2\" style=\"background:var(--surface)\">\n            <div class=\"w-full max-w-[440px] px-12\" data-kid=\"1-1-2-1\">\n                <h1 class=\"h text-[32px] leading-[1.1] tracking-[-0.7px] font-[650]\" data-kid=\"1-1-2-1-1\" style=\"color:var(--ink)\">\n                    Masuk ke akun Anda\n                </h1>\n                <p class=\"text-[15px] mt-2\" data-kid=\"1-1-2-1-2\">\n                    Lanjutkan mencatat dan memantau lamaran kerja Anda.\n                </p>\n                <!-- auth error above action -->\n                <div class=\"mt-7 border-l-[3px] px-3.5 py-3\" data-kid=\"1-1-2-1-3\" style=\"border-color:var(--dest);background:#B83A450f\">\n                    <p class=\"text-[13.5px]\" data-kid=\"1-1-2-1-3-1\" style=\"color:var(--dest)\">\n                        Email atau password salah. Coba lagi.\n                    </p>\n                </div>\n                <form class=\"mt-6\" data-kid=\"1-1-2-1-4\">\n                    <div class=\"mb-5\" data-kid=\"1-1-2-1-4-1\">\n                        <label class=\"block text-[13.5px] font-semibold mb-1.5\" data-kid=\"1-1-2-1-4-1-1\" for=\"lg-email\" style=\"color:var(--ink)\">\n                            Email\n                        </label>\n                        <input class=\"fld\" data-kid=\"1-1-2-1-4-1-2\" id=\"lg-email\" type=\"email\" value=\"rani.pratiwi@email.com\"/>\n                    </div>\n                    <div class=\"mb-2\" data-kid=\"1-1-2-1-4-2\">\n                        <label class=\"block text-[13.5px] font-semibold mb-1.5\" data-kid=\"1-1-2-1-4-2-1\" for=\"lg-pw\" style=\"color:var(--ink)\">\n                            Password\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-1-2-1-4-2-2\">\n                            <input class=\"fld pr-11\" data-kid=\"1-1-2-1-4-2-2-1\" id=\"lg-pw\" type=\"password\" value=\"rahasia123\"/>\n                            <button aria-label=\"Tampilkan password\" class=\"absolute right-0 top-0 h-[44px] w-[44px] grid place-items-center text-[17px]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-2-2\" data-name=\"password visibility toggle button\" data-reason=\"icon and aria-label replaced by script on click\" id=\"lg-toggle\" style=\"color:var(--ink2)\" type=\"button\">\n                                <i class=\"ti ti-eye\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-2-2-1\" data-name=\"password visibility icon\" data-reason=\"icon class replaced by script on click\">\n                                </i>\n                            </button>\n                        </div>\n                        <p class=\"text-[12.5px] mt-1.5\" data-kid=\"1-1-2-1-4-2-3\" style=\"color:var(--dest)\">\n                            Password tidak cocok dengan akun ini.\n                        </p>\n                    </div>\n                    <div class=\"flex justify-end mb-6\" data-kid=\"1-1-2-1-4-3\">\n                        <a class=\"text-[13px] hover:underline\" data-kid=\"1-1-2-1-4-3-1\" href=\"#\" style=\"color:var(--ink)\">\n                            Lupa password?\n                        </a>\n                    </div>\n                    <button class=\"w-full h-[46px] rounded-[4px] text-white text-[15px] font-semibold\" data-kid=\"1-1-2-1-4-4\" style=\"background:var(--pri)\" type=\"button\">\n                        Masuk\n                    </button>\n                    <p class=\"text-[14px] mt-5\" data-kid=\"1-1-2-1-4-5\">\n                        Belum punya akun?\n                        <a class=\"underline\" data-kid=\"1-1-2-1-4-5-1\" href=\"#\" style=\"color:var(--ink)\">\n                            Buat akun\n                        </a>\n                    </p>\n                </form>\n                <div class=\"mt-10 pt-5 border-t\" data-kid=\"1-1-2-1-5\" style=\"border-color:var(--hair)\">\n                    <p class=\"text-[12.5px] leading-[1.55]\" data-kid=\"1-1-2-1-5-1\">\n                        Sesi disimpan menggunakan token. Anda hanya dapat mengakses data lamaran milik akun sendiri.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (function(){\n    var t=document.getElementById('lg-toggle'), p=document.getElementById('lg-pw');\n    t.addEventListener('click',function(){\n      var show = p.type==='password';\n      p.type = show ? 'text' : 'password';\n      t.innerHTML = '<i class=\"ti ti-eye'+(show?'-off':'')+'\"></i>';\n      t.setAttribute('aria-label', show?'Sembunyikan password':'Tampilkan password');\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-14T20:28:52.332406+00:00",
      "modified": "2026-09-14T20:29:10.910350+00:00",
      "id": "var_8ecc5e10287a",
      "viewportScrollY": 60
    }
  },
