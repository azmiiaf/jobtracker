      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Atkinson+Hyperlegible+Next:wght@200..800&family=Fragment+Mono&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css');\n.h{font-family:'Familjen Grotesk',ui-sans-serif,sans-serif}\n.b{font-family:'Atkinson Hyperlegible Next','Atkinson Hyperlegible',ui-sans-serif,sans-serif}\n.m{font-family:'Fragment Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}\n.cut{position:relative}\n.cut::after{content:\"\";position:absolute;top:0;right:0;width:10px;height:10px;background:var(--canvas);clip-path:polygon(100% 0,100% 100%,0 0)}\n.fade{opacity:0;transform:translateY(6px);transition:opacity .32s ease,transform .32s ease}\n.fade.on{opacity:1;transform:none}\n</style>\n<div class=\"b\" data-kid=\"1\" style=\"--canvas:#EEF2F0;--surface:#FBFCFA;--raised:#FFFFFF;--ink:#17201C;--ink2:#53605A;--hair:#C9D3CE;--div:#8D9C95;--pri:#087554;--pri-h:#065E44;--focus:#D49A18;--dest:#B83A45;background:var(--canvas);color:var(--ink2)\">\n    <!-- ================= NAV ================= -->\n    <header class=\"border-b\" data-kid=\"1-1\" style=\"border-color:var(--hair);background:var(--surface)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 h-[60px] flex items-center justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\">\n                <span class=\"inline-block w-[18px] h-[18px]\" data-kid=\"1-1-1-1-1\" style=\"border-left:2px solid var(--pri);border-bottom:2px solid var(--pri)\">\n                </span>\n                <span class=\"h text-[19px] font-[650] tracking-[-0.2px]\" data-kid=\"1-1-1-1-2\" style=\"color:var(--ink)\">\n                    Jejak\n                </span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-7 text-[14px]\" data-kid=\"1-1-1-2\">\n                <a class=\"hover:underline\" data-kid=\"1-1-1-2-1\" href=\"#alur\" style=\"color:var(--ink2)\">\n                    Cara kerja\n                </a>\n                <a class=\"hover:underline\" data-kid=\"1-1-1-2-2\" href=\"#detail\" style=\"color:var(--ink2)\">\n                    Riwayat status\n                </a>\n                <a class=\"hover:underline\" data-kid=\"1-1-1-2-3\" href=\"#cv\" style=\"color:var(--ink2)\">\n                    Versi CV\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-3\">\n                <a class=\"text-[14px] hover:underline\" data-kid=\"1-1-1-3-1\" href=\"#\" style=\"color:var(--ink)\">\n                    Masuk\n                </a>\n                <a class=\"text-[14px] font-semibold px-4 h-[38px] inline-flex items-center rounded-[4px] text-white\" data-kid=\"1-1-1-3-2\" href=\"#\" style=\"background:var(--pri)\">\n                    Buat akun\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- ================= HERO ================= -->\n    <section class=\"overflow-hidden\" data-kid=\"1-2\" style=\"background:var(--surface)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 pt-14 pb-12 grid grid-cols-12 gap-8 items-start\" data-kid=\"1-2-1\">\n            <div class=\"col-span-5\" data-kid=\"1-2-1-1\">\n                <p class=\"m text-[11px] uppercase tracking-[0.14em] mb-5\" data-kid=\"1-2-1-1-1\" style=\"color:var(--div)\">\n                    Pencatatan lamaran kerja\n                </p>\n                <h1 class=\"h text-[52px] leading-[1.04] tracking-[-1.6px] font-[650]\" data-kid=\"1-2-1-1-2\" style=\"color:var(--ink)\">\n                    Semua lamaran,\n                    <br data-kid=\"1-2-1-1-2-1\"/>\n                    satu jejak\n                    <br data-kid=\"1-2-1-1-2-2\"/>\n                    yang jelas.\n                </h1>\n                <p class=\"mt-6 text-[16px] leading-[1.62] max-w-[420px]\" data-kid=\"1-2-1-1-3\">\n                    Catat posisi yang dilamar, CV yang digunakan, perubahan status, dan jadwal wawancara tanpa berpindah spreadsheet.\n                </p>\n                <div class=\"mt-8 flex items-center gap-6\" data-kid=\"1-2-1-1-4\">\n                    <a class=\"text-[15px] font-semibold px-6 h-[44px] inline-flex items-center rounded-[4px] text-white\" data-kid=\"1-2-1-1-4-1\" href=\"#\" style=\"background:var(--pri)\">\n                        Buat akun\n                    </a>\n                    <span class=\"text-[14px]\" data-kid=\"1-2-1-1-4-2\">\n                        Sudah punya akun?\n                        <a class=\"underline\" data-kid=\"1-2-1-1-4-2-1\" href=\"#\" style=\"color:var(--ink)\">\n                            Masuk\n                        </a>\n                    </span>\n                </div>\n                <div class=\"mt-10 pt-6 border-t flex items-start gap-7\" data-kid=\"1-2-1-1-5\" style=\"border-color:var(--hair)\">\n                    <div class=\"flex items-start gap-2.5 max-w-[170px]\" data-kid=\"1-2-1-1-5-1\">\n                        <span class=\"text-[17px] leading-none mt-0.5\" data-kid=\"1-2-1-1-5-1-1\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-briefcase\" data-kid=\"1-2-1-1-5-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] leading-[1.5]\" data-kid=\"1-2-1-1-5-1-2\">\n                            9 status rekrutmen, dari Wishlist sampai Diterima\n                        </span>\n                    </div>\n                    <div class=\"flex items-start gap-2.5 max-w-[170px]\" data-kid=\"1-2-1-1-5-2\">\n                        <span class=\"text-[17px] leading-none mt-0.5\" data-kid=\"1-2-1-1-5-2-1\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-history\" data-kid=\"1-2-1-1-5-2-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] leading-[1.5]\" data-kid=\"1-2-1-1-5-2-2\">\n                            Setiap perubahan status tersimpan sebagai riwayat\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- product crop -->\n            <div class=\"col-span-7 -mr-24\" data-kid=\"1-2-1-2\">\n                <div class=\"cut border\" data-kid=\"1-2-1-2-1\" style=\"border-color:var(--hair);background:var(--raised);border-radius:8px\">\n                    <div class=\"flex items-center justify-between px-5 h-[46px] border-b\" data-kid=\"1-2-1-2-1-1\" style=\"border-color:var(--hair)\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1-1-1\">\n                            <span class=\"inline-block w-[12px] h-[12px]\" data-kid=\"1-2-1-2-1-1-1-1\" style=\"border-left:2px solid var(--pri);border-bottom:2px solid var(--pri)\">\n                            </span>\n                            <span class=\"h text-[13px] font-[600]\" data-kid=\"1-2-1-2-1-1-1-2\" style=\"color:var(--ink)\">\n                                Ringkasan\n                            </span>\n                        </div>\n                        <span class=\"m text-[11px]\" data-kid=\"1-2-1-2-1-1-2\" style=\"color:var(--div)\">\n                            Data contoh\n                        </span>\n                    </div>\n                    <!-- status matrix -->\n                    <div class=\"p-5\" data-kid=\"1-2-1-2-1-2\">\n                        <div class=\"grid grid-cols-4\" data-kid=\"1-2-1-2-1-2-1\" style=\"border:1px solid var(--hair)\">\n                            <div class=\"col-span-2 row-span-2 p-4 border-r border-b\" data-kid=\"1-2-1-2-1-2-1-1\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[12px] mb-1\" data-kid=\"1-2-1-2-1-2-1-1-1\">\n                                    Total lamaran\n                                </p>\n                                <p class=\"m text-[38px] leading-none\" data-kid=\"1-2-1-2-1-2-1-1-2\" style=\"color:var(--ink)\">\n                                    32\n                                </p>\n                                <p class=\"text-[11px] mt-3\" data-kid=\"1-2-1-2-1-2-1-1-3\" style=\"color:var(--div)\">\n                                    12 masih berjalan\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-r border-b\" data-kid=\"1-2-1-2-1-2-1-2\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-2-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-2-1-1\" style=\"background:#2867A5\">\n                                    </span>\n                                    Dikirim\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-2-2\" style=\"color:var(--ink)\">\n                                    32\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-b\" data-kid=\"1-2-1-2-1-2-1-3\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-3-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-3-1-1\" style=\"background:#7256A0\">\n                                    </span>\n                                    Seleksi awal\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-3-2\" style=\"color:var(--ink)\">\n                                    9\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-r border-b\" data-kid=\"1-2-1-2-1-2-1-4\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-4-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-4-1-1\" style=\"background:#B8780D\">\n                                    </span>\n                                    Wawancara\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-4-2\" style=\"color:var(--ink)\">\n                                    5\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-b\" data-kid=\"1-2-1-2-1-2-1-5\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-5-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-5-1-1\" style=\"background:#BF5831\">\n                                    </span>\n                                    Tes teknis\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-5-2\" style=\"color:var(--ink)\">\n                                    2\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-r\" data-kid=\"1-2-1-2-1-2-1-6\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-6-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-6-1-1\" style=\"background:#00796F\">\n                                    </span>\n                                    Penawaran\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-6-2\" style=\"color:var(--ink)\">\n                                    1\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-r\" data-kid=\"1-2-1-2-1-2-1-7\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-7-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-7-1-1\" style=\"background:#18794E\">\n                                    </span>\n                                    Diterima\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-7-2\" style=\"color:var(--ink)\">\n                                    1\n                                </p>\n                            </div>\n                            <div class=\"p-3 border-r\" data-kid=\"1-2-1-2-1-2-1-8\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-8-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-8-1-1\" style=\"background:#B83A45\">\n                                    </span>\n                                    Ditolak\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-8-2\" style=\"color:var(--ink)\">\n                                    12\n                                </p>\n                            </div>\n                            <div class=\"p-3\" data-kid=\"1-2-1-2-1-2-1-9\" style=\"border-color:var(--hair)\">\n                                <p class=\"text-[11px] flex items-center gap-1.5\" data-kid=\"1-2-1-2-1-2-1-9-1\">\n                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-1-9-1-1\" style=\"background:#69736E\">\n                                    </span>\n                                    Wishlist\n                                </p>\n                                <p class=\"m text-[20px] mt-1\" data-kid=\"1-2-1-2-1-2-1-9-2\" style=\"color:var(--ink)\">\n                                    4\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-12 gap-5 mt-5\" data-kid=\"1-2-1-2-1-2-2\">\n                            <div class=\"col-span-7\" data-kid=\"1-2-1-2-1-2-2-1\">\n                                <p class=\"h text-[12px] font-[600] uppercase tracking-[0.08em] mb-2\" data-kid=\"1-2-1-2-1-2-2-1-1\" style=\"color:var(--div)\">\n                                    Lamaran terbaru\n                                </p>\n                                <table class=\"w-full text-left\" data-kid=\"1-2-1-2-1-2-2-1-2\">\n                                    <tbody data-kid=\"1-2-1-2-1-2-2-1-2-1\">\n                                        <tr class=\"border-t\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1\" style=\"border-color:var(--hair)\">\n                                            <td class=\"py-2.5 pr-3\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-1\">\n                                                <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-1-1\" style=\"color:var(--ink)\">\n                                                    PT ABC\n                                                </p>\n                                                <p class=\"text-[11px]\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-1-2\">\n                                                    Frontend Developer\n                                                </p>\n                                            </td>\n                                            <td class=\"py-2.5 pr-2\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-2\" data-name=\"application status badge\" data-reason=\"text and styles replaced by script after loading\">\n                                                <span class=\"inline-flex items-center gap-1.5 text-[11px] px-2 py-[3px] rounded-[3px] border\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-2-1\" id=\"lp-status\" style=\"border-color:#2867A555;background:#2867A514;color:#2867A5\">\n                                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-2-1-1\" style=\"background:currentColor\">\n                                                    </span>\n                                                    <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-2-1-2\" data-name=\"application status label text\" data-reason=\"text replaced by script after loading\" id=\"lp-status-label\">\n                                                        Dikirim\n                                                    </span>\n                                                </span>\n                                            </td>\n                                            <td class=\"py-2.5 m text-[11px] whitespace-nowrap\" data-kid=\"1-2-1-2-1-2-2-1-2-1-1-3\">\n                                                14 Sep 2026\n                                            </td>\n                                        </tr>\n                                        <tr class=\"border-t\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2\" style=\"border-color:var(--hair)\">\n                                            <td class=\"py-2.5 pr-3\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-1\">\n                                                <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-1-1\" style=\"color:var(--ink)\">\n                                                    PT XYZ\n                                                </p>\n                                                <p class=\"text-[11px]\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-1-2\">\n                                                    Web Developer\n                                                </p>\n                                            </td>\n                                            <td class=\"py-2.5 pr-2\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-2\">\n                                                <span class=\"inline-flex items-center gap-1.5 text-[11px] px-2 py-[3px] rounded-[3px] border\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-2-1\" style=\"border-color:#7256A055;background:#7256A014;color:#7256A0\">\n                                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-2-1-1\" style=\"background:currentColor\">\n                                                    </span>\n                                                    Seleksi awal\n                                                </span>\n                                            </td>\n                                            <td class=\"py-2.5 m text-[11px] whitespace-nowrap\" data-kid=\"1-2-1-2-1-2-2-1-2-1-2-3\">\n                                                15 Sep 2026\n                                            </td>\n                                        </tr>\n                                        <tr class=\"border-t border-b\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3\" style=\"border-color:var(--hair)\">\n                                            <td class=\"py-2.5 pr-3\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-1\">\n                                                <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-1-1\" style=\"color:var(--ink)\">\n                                                    Nusantara Digital\n                                                </p>\n                                                <p class=\"text-[11px]\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-1-2\">\n                                                    React Engineer\n                                                </p>\n                                            </td>\n                                            <td class=\"py-2.5 pr-2\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-2\">\n                                                <span class=\"inline-flex items-center gap-1.5 text-[11px] px-2 py-[3px] rounded-[3px] border\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-2-1\" style=\"border-color:#B83A4555;background:#B83A4514;color:#B83A45\">\n                                                    <span class=\"w-[6px] h-[6px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-2-1-1\" style=\"background:currentColor\">\n                                                    </span>\n                                                    Ditolak\n                                                </span>\n                                            </td>\n                                            <td class=\"py-2.5 m text-[11px] whitespace-nowrap\" data-kid=\"1-2-1-2-1-2-2-1-2-1-3-3\">\n                                                08 Sep 2026\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                            <div class=\"col-span-5\" data-kid=\"1-2-1-2-1-2-2-2\">\n                                <p class=\"h text-[12px] font-[600] uppercase tracking-[0.08em] mb-2\" data-kid=\"1-2-1-2-1-2-2-2-1\" style=\"color:var(--div)\">\n                                    Wawancara terdekat\n                                </p>\n                                <div class=\"border-t pt-2.5\" data-kid=\"1-2-1-2-1-2-2-2-2\" style=\"border-color:var(--hair)\">\n                                    <p class=\"m text-[11px]\" data-kid=\"1-2-1-2-1-2-2-2-2-1\" style=\"color:#B8780D\">\n                                        20 Sep 2026 · 10:00 WIB\n                                    </p>\n                                    <p class=\"text-[13px] font-semibold mt-1\" data-kid=\"1-2-1-2-1-2-2-2-2-2\" style=\"color:var(--ink)\">\n                                        PT ABC\n                                    </p>\n                                    <p class=\"text-[11px]\" data-kid=\"1-2-1-2-1-2-2-2-2-3\">\n                                        Frontend Developer\n                                    </p>\n                                    <p class=\"text-[11px] mt-1.5\" data-kid=\"1-2-1-2-1-2-2-2-2-4\">\n                                        Technical Interview\n                                    </p>\n                                </div>\n                                <div class=\"border-t mt-3 pt-2.5\" data-kid=\"1-2-1-2-1-2-2-2-3\" style=\"border-color:var(--hair)\">\n                                    <p class=\"m text-[11px]\" data-kid=\"1-2-1-2-1-2-2-2-3-1\">\n                                        24 Sep 2026 · 14:30 WIB\n                                    </p>\n                                    <p class=\"text-[13px] font-semibold mt-1\" data-kid=\"1-2-1-2-1-2-2-2-3-2\" style=\"color:var(--ink)\">\n                                        PT Sinar Data\n                                    </p>\n                                    <p class=\"text-[11px]\" data-kid=\"1-2-1-2-1-2-2-2-3-3\">\n                                        Fullstack Developer\n                                    </p>\n                                    <p class=\"text-[11px] mt-1.5\" data-kid=\"1-2-1-2-1-2-2-2-3-4\">\n                                        HR Interview\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <!-- timeline preview that gains an entry -->\n                        <div class=\"mt-5 pt-4 border-t\" data-kid=\"1-2-1-2-1-2-3\" style=\"border-color:var(--hair)\">\n                            <p class=\"h text-[12px] font-[600] uppercase tracking-[0.08em] mb-3\" data-kid=\"1-2-1-2-1-2-3-1\" style=\"color:var(--div)\">\n                                Riwayat status — PT ABC\n                            </p>\n                            <div class=\"flex items-start gap-0\" data-kid=\"1-2-1-2-1-2-3-2\">\n                                <div class=\"flex items-center gap-2 pr-4\" data-kid=\"1-2-1-2-1-2-3-2-1\">\n                                    <span class=\"w-[10px] h-[10px] rounded-full inline-block\" data-kid=\"1-2-1-2-1-2-3-2-1-1\" style=\"background:#2867A5\">\n                                    </span>\n                                    <span class=\"text-[12px] whitespace-nowrap\" data-kid=\"1-2-1-2-1-2-3-2-1-2\" style=\"color:var(--ink)\">\n                                        Dikirim\n                                    </span>\n                                    <span class=\"m text-[11px]\" data-kid=\"1-2-1-2-1-2-3-2-1-3\">\n                                        14 Sep\n                                    </span>\n                                </div>\n                                <div class=\"h-[1px] w-8 mt-[6px]\" data-kid=\"1-2-1-2-1-2-3-2-2\" style=\"background:var(--hair)\">\n                                </div>\n                                <div class=\"fade flex items-center gap-2 pl-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-3-2-3\" data-name=\"new timeline entry container\" data-reason=\"visibility toggled and styled by script\" id=\"lp-tl-new\">\n                                    <span class=\"w-[10px] h-[10px] rounded-full inline-block ring-2 ring-offset-2\" data-kid=\"1-2-1-2-1-2-3-2-3-1\" style=\"background:#B8780D;--tw-ring-color:#B8780D55\">\n                                    </span>\n                                    <span class=\"text-[12px] whitespace-nowrap\" data-kid=\"1-2-1-2-1-2-3-2-3-2\" style=\"color:var(--ink)\">\n                                        Wawancara\n                                    </span>\n                                    <span class=\"m text-[11px]\" data-kid=\"1-2-1-2-1-2-3-2-3-3\">\n                                        18 Sep\n                                    </span>\n                                    <span class=\"m text-[10px] px-1.5 py-[1px] rounded-[3px] border\" data-kid=\"1-2-1-2-1-2-3-2-3-4\" style=\"border-color:var(--hair);color:var(--div)\">\n                                        Saat ini\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= TWO WORKFLOWS ================= -->\n    <section class=\"border-t\" data-kid=\"1-3\" id=\"alur\" style=\"border-color:var(--hair)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 py-14\" data-kid=\"1-3-1\">\n            <h2 class=\"h text-[30px] leading-[1.15] tracking-[-0.6px] font-[600] max-w-[520px]\" data-kid=\"1-3-1-1\" style=\"color:var(--ink)\">\n                Dua alur, sesuai kondisi lamaran Anda.\n            </h2>\n            <div class=\"mt-10 border-t\" data-kid=\"1-3-1-2\" style=\"border-color:var(--div)\">\n                <div class=\"grid grid-cols-12 gap-8 py-7 border-b\" data-kid=\"1-3-1-2-1\" style=\"border-color:var(--hair)\">\n                    <div class=\"col-span-4\" data-kid=\"1-3-1-2-1-1\">\n                        <p class=\"m text-[11px] uppercase tracking-[0.14em] mb-2\" data-kid=\"1-3-1-2-1-1-1\" style=\"color:var(--div)\">\n                            Alur 01\n                        </p>\n                        <p class=\"h text-[20px] font-[600]\" data-kid=\"1-3-1-2-1-1-2\" style=\"color:var(--ink)\">\n                            Sudah melamar\n                        </p>\n                        <p class=\"text-[14px] mt-2 max-w-[280px]\" data-kid=\"1-3-1-2-1-1-3\">\n                            Catat lamaran sekali, lalu perbarui status setiap kali ada respons.\n                        </p>\n                    </div>\n                    <div class=\"col-span-8 flex items-center gap-3 flex-wrap\" data-kid=\"1-3-1-2-1-2\">\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-1-2-1\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Catat lamaran\n                        </span>\n                        <span data-kid=\"1-3-1-2-1-2-2\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-1-2-1-2-2-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-1-2-3\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Perbarui status\n                        </span>\n                        <span data-kid=\"1-3-1-2-1-2-4\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-1-2-1-2-4-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-1-2-5\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Lihat riwayat dan hasil\n                        </span>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-12 gap-8 py-7 border-b\" data-kid=\"1-3-1-2-2\" style=\"border-color:var(--hair)\">\n                    <div class=\"col-span-4\" data-kid=\"1-3-1-2-2-1\">\n                        <p class=\"m text-[11px] uppercase tracking-[0.14em] mb-2\" data-kid=\"1-3-1-2-2-1-1\" style=\"color:var(--div)\">\n                            Alur 02\n                        </p>\n                        <p class=\"h text-[20px] font-[600]\" data-kid=\"1-3-1-2-2-1-2\" style=\"color:var(--ink)\">\n                            Belum siap melamar\n                        </p>\n                        <p class=\"text-[14px] mt-2 max-w-[280px]\" data-kid=\"1-3-1-2-2-1-3\">\n                            Simpan lowongan beserta deadline, lalu ubah menjadi lamaran tanpa input ulang.\n                        </p>\n                    </div>\n                    <div class=\"col-span-8 flex items-center gap-3 flex-wrap\" data-kid=\"1-3-1-2-2-2\">\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-2-2-1\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Simpan lowongan\n                        </span>\n                        <span data-kid=\"1-3-1-2-2-2-2\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-1-2-2-2-2-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-2-2-3\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Tinjau kembali\n                        </span>\n                        <span data-kid=\"1-3-1-2-2-2-4\" style=\"color:var(--div)\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-1-2-2-2-4-1\">\n                            </i>\n                        </span>\n                        <span class=\"text-[14px] px-3.5 py-2 border rounded-[4px]\" data-kid=\"1-3-1-2-2-2-5\" style=\"border-color:var(--hair);background:var(--surface);color:var(--ink)\">\n                            Jadikan lamaran\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= DETAIL + TIMELINE ================= -->\n    <section class=\"border-t\" data-kid=\"1-4\" id=\"detail\" style=\"border-color:var(--hair);background:var(--surface)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 py-14\" data-kid=\"1-4-1\">\n            <div class=\"grid grid-cols-12 gap-10 items-start\" data-kid=\"1-4-1-1\">\n                <div class=\"col-span-4\" data-kid=\"1-4-1-1-1\">\n                    <h2 class=\"h text-[30px] leading-[1.15] tracking-[-0.6px] font-[600]\" data-kid=\"1-4-1-1-1-1\" style=\"color:var(--ink)\">\n                        Riwayat proses,\n                        <br data-kid=\"1-4-1-1-1-1-1\"/>\n                        bukan hanya status akhir.\n                    </h2>\n                    <p class=\"text-[15px] mt-4 leading-[1.62]\" data-kid=\"1-4-1-1-1-2\">\n                        Setiap perubahan status disimpan bersama tanggal dan catatan, sehingga Anda tahu seluruh perjalanan rekrutmen di satu perusahaan.\n                    </p>\n                </div>\n                <div class=\"col-span-8 grid grid-cols-2 gap-0 border\" data-kid=\"1-4-1-1-2\" style=\"border-color:var(--hair);background:var(--raised);border-radius:8px\">\n                    <div class=\"p-6 border-r\" data-kid=\"1-4-1-1-2-1\" style=\"border-color:var(--hair)\">\n                        <p class=\"h text-[18px] font-[600]\" data-kid=\"1-4-1-1-2-1-1\" style=\"color:var(--ink)\">\n                            PT ABC\n                        </p>\n                        <p class=\"text-[13px]\" data-kid=\"1-4-1-1-2-1-2\">\n                            Frontend Developer\n                        </p>\n                        <dl class=\"mt-5 text-[13px]\" data-kid=\"1-4-1-1-2-1-3\">\n                            <div class=\"flex justify-between gap-4 py-2.5 border-t\" data-kid=\"1-4-1-1-2-1-3-1\" style=\"border-color:var(--hair)\">\n                                <dt data-kid=\"1-4-1-1-2-1-3-1-1\">\n                                    Lokasi\n                                </dt>\n                                <dd class=\"text-right\" data-kid=\"1-4-1-1-2-1-3-1-2\" style=\"color:var(--ink)\">\n                                    Jakarta Selatan\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-4 py-2.5 border-t\" data-kid=\"1-4-1-1-2-1-3-2\" style=\"border-color:var(--hair)\">\n                                <dt data-kid=\"1-4-1-1-2-1-3-2-1\">\n                                    Tipe kerja\n                                </dt>\n                                <dd class=\"text-right\" data-kid=\"1-4-1-1-2-1-3-2-2\" style=\"color:var(--ink)\">\n                                    Hybrid\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-4 py-2.5 border-t\" data-kid=\"1-4-1-1-2-1-3-3\" style=\"border-color:var(--hair)\">\n                                <dt data-kid=\"1-4-1-1-2-1-3-3-1\">\n                                    Gaji\n                                </dt>\n                                <dd class=\"m text-right text-[12px]\" data-kid=\"1-4-1-1-2-1-3-3-2\" style=\"color:var(--ink)\">\n                                    Rp 9–13 jt\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-4 py-2.5 border-t\" data-kid=\"1-4-1-1-2-1-3-4\" style=\"border-color:var(--hair)\">\n                                <dt data-kid=\"1-4-1-1-2-1-3-4-1\">\n                                    Source\n                                </dt>\n                                <dd class=\"text-right\" data-kid=\"1-4-1-1-2-1-3-4-2\" style=\"color:var(--ink)\">\n                                    LinkedIn\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between gap-4 py-2.5 border-t border-b\" data-kid=\"1-4-1-1-2-1-3-5\" style=\"border-color:var(--hair)\">\n                                <dt data-kid=\"1-4-1-1-2-1-3-5-1\">\n                                    CV digunakan\n                                </dt>\n                                <dd class=\"text-right\" data-kid=\"1-4-1-1-2-1-3-5-2\" style=\"color:var(--ink)\">\n                                    CV Frontend 2026\n                                </dd>\n                            </div>\n                        </dl>\n                    </div>\n                    <div class=\"p-6\" data-kid=\"1-4-1-1-2-2\">\n                        <p class=\"h text-[12px] font-[600] uppercase tracking-[0.08em] mb-4\" data-kid=\"1-4-1-1-2-2-1\" style=\"color:var(--div)\">\n                            Riwayat status\n                        </p>\n                        <ol class=\"relative pl-5\" data-kid=\"1-4-1-1-2-2-2\">\n                            <span class=\"absolute left-[4px] top-[6px] bottom-[10px] w-[2px]\" data-kid=\"1-4-1-1-2-2-2-1\" style=\"background:var(--hair)\">\n                            </span>\n                            <li class=\"relative pb-4\" data-kid=\"1-4-1-1-2-2-2-2\">\n                                <span class=\"absolute -left-5 top-[5px] w-[10px] h-[10px] rounded-full\" data-kid=\"1-4-1-1-2-2-2-2-1\" style=\"background:#2867A5\">\n                                </span>\n                                <p class=\"m text-[11px]\" data-kid=\"1-4-1-1-2-2-2-2-2\">\n                                    14 Sep 2026\n                                </p>\n                                <p class=\"text-[13px]\" data-kid=\"1-4-1-1-2-2-2-2-3\" style=\"color:var(--ink)\">\n                                    Dikirim\n                                </p>\n                            </li>\n                            <li class=\"relative pb-4\" data-kid=\"1-4-1-1-2-2-2-3\">\n                                <span class=\"absolute -left-5 top-[5px] w-[10px] h-[10px] rounded-full\" data-kid=\"1-4-1-1-2-2-2-3-1\" style=\"background:#7256A0\">\n                                </span>\n                                <p class=\"m text-[11px]\" data-kid=\"1-4-1-1-2-2-2-3-2\">\n                                    16 Sep 2026\n                                </p>\n                                <p class=\"text-[13px]\" data-kid=\"1-4-1-1-2-2-2-3-3\" style=\"color:var(--ink)\">\n                                    Seleksi awal\n                                </p>\n                                <p class=\"text-[12px] mt-0.5\" data-kid=\"1-4-1-1-2-2-2-3-4\">\n                                    Dihubungi rekruter via WhatsApp.\n                                </p>\n                            </li>\n                            <li class=\"relative pb-4\" data-kid=\"1-4-1-1-2-2-2-4\">\n                                <span class=\"absolute -left-5 top-[5px] w-[10px] h-[10px] rounded-full\" data-kid=\"1-4-1-1-2-2-2-4-1\" style=\"background:#B8780D\">\n                                </span>\n                                <p class=\"m text-[11px]\" data-kid=\"1-4-1-1-2-2-2-4-2\">\n                                    18 Sep 2026\n                                </p>\n                                <p class=\"text-[13px]\" data-kid=\"1-4-1-1-2-2-2-4-3\" style=\"color:var(--ink)\">\n                                    Wawancara\n                                </p>\n                            </li>\n                            <li class=\"relative\" data-kid=\"1-4-1-1-2-2-2-5\">\n                                <span class=\"absolute -left-[23px] top-[2px] w-[16px] h-[16px] rounded-full border-[4px]\" data-kid=\"1-4-1-1-2-2-2-5-1\" style=\"background:#BF5831;border-color:#BF583133\">\n                                </span>\n                                <p class=\"m text-[11px]\" data-kid=\"1-4-1-1-2-2-2-5-2\">\n                                    20 Sep 2026\n                                </p>\n                                <p class=\"text-[13px] flex items-center gap-2\" data-kid=\"1-4-1-1-2-2-2-5-3\" style=\"color:var(--ink)\">\n                                    Tes teknis\n                                    <span class=\"m text-[10px] px-1.5 py-[1px] rounded-[3px] border\" data-kid=\"1-4-1-1-2-2-2-5-3-1\" style=\"border-color:var(--hair);color:var(--div)\">\n                                        Saat ini\n                                    </span>\n                                </p>\n                                <p class=\"text-[12px] mt-0.5\" data-kid=\"1-4-1-1-2-2-2-5-4\">\n                                    Take-home test, tenggat 3 hari.\n                                </p>\n                            </li>\n                        </ol>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CLOSING ================= -->\n    <section class=\"border-t\" data-kid=\"1-5\" id=\"cv\" style=\"border-color:var(--hair)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 py-14 grid grid-cols-12 gap-8 items-end\" data-kid=\"1-5-1\">\n            <div class=\"col-span-8\" data-kid=\"1-5-1-1\">\n                <h2 class=\"h text-[34px] leading-[1.12] tracking-[-0.8px] font-[600] max-w-[560px]\" data-kid=\"1-5-1-1-1\" style=\"color:var(--ink)\">\n                    CV disimpan sebagai nama versi, bukan file.\n                </h2>\n                <p class=\"text-[15px] mt-4 max-w-[500px] leading-[1.62]\" data-kid=\"1-5-1-1-2\">\n                    Anda cukup mencatat versi mana yang dipakai —\n                    <span class=\"m text-[13px]\" data-kid=\"1-5-1-1-2-1\" style=\"color:var(--ink)\">\n                        CV Frontend 2026\n                    </span>\n                    ,\n                    <span class=\"m text-[13px]\" data-kid=\"1-5-1-1-2-2\" style=\"color:var(--ink)\">\n                        CV Fullstack 2026\n                    </span>\n                    — lalu bandingkan versi mana yang paling sering lolos ke wawancara.\n                </p>\n            </div>\n            <div class=\"col-span-4 flex md:justify-end\" data-kid=\"1-5-1-2\">\n                <a class=\"text-[15px] font-semibold px-6 h-[44px] inline-flex items-center rounded-[4px] text-white\" data-kid=\"1-5-1-2-1\" href=\"#\" style=\"background:var(--pri)\">\n                    Mulai mencatat lamaran\n                </a>\n            </div>\n        </div>\n    </section>\n    <footer class=\"border-t\" data-kid=\"1-6\" style=\"border-color:var(--hair);background:var(--surface)\">\n        <div class=\"mx-auto max-w-[1160px] px-8 py-7 flex items-center justify-between\" data-kid=\"1-6-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-6-1-1\">\n                <span class=\"inline-block w-[14px] h-[14px]\" data-kid=\"1-6-1-1-1\" style=\"border-left:2px solid var(--pri);border-bottom:2px solid var(--pri)\">\n                </span>\n                <span class=\"h text-[15px] font-[650]\" data-kid=\"1-6-1-1-2\" style=\"color:var(--ink)\">\n                    Jejak\n                </span>\n            </div>\n            <p class=\"m text-[11px]\" data-kid=\"1-6-1-2\" style=\"color:var(--div)\">\n                Job Application Tracker · 2026\n            </p>\n        </div>\n    </footer>\n</div>\n<script>\n    (function(){\n    var st = document.getElementById('lp-status');\n    var lb = document.getElementById('lp-status-label');\n    var tl = document.getElementById('lp-tl-new');\n    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    function finish(){\n      lb.textContent = 'Wawancara';\n      st.style.color = '#B8780D';\n      st.style.borderColor = '#B8780D55';\n      st.style.background = '#B8780D14';\n      tl.classList.add('on');\n    }\n    if (reduce) { finish(); return; }\n    st.style.transition = 'color .3s ease, background-color .3s ease, border-color .3s ease';\n    setTimeout(finish, 2200);\n  })();\n</script>\n",
